{
  "name": "univer-headless-bridge",
  "version": "0.1.0",
  "description": "Headless Markdown -> Univer IDocumentData -> vector PDF bridge (agent-facing CLI + Playwright harness for @univerjs/engine-render).",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "univer-pdf": "./dist/cli.js"
  },
  "scripts": {
    "build": "pnpm run build:web && pnpm run build:node",
    "build:web": "tsx scripts/build-web.ts",
    "build:node": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.browser.json",
    "render": "node dist/cli.js",
    "browser:install": "playwright install chromium",
    "test": "pnpm run build:node && node --test dist/adapter/*.test.js",
    "example": "node dist/cli.js -i examples/sample.md -o out/sample.pdf --dump-snapshot -v"
  },
  "dependencies": {
    "@univerjs/core": "1.0.0",
    "@univerjs/docs": "1.0.0",
    "@univerjs/engine-formula": "1.0.0",
    "@univerjs/engine-render": "1.0.0",
    "canvas2svg": "1.0.16",
    "commander": "14.0.1",
    "dejavu-fonts-ttf": "2.37.3",
    "mdast-util-to-string": "4.0.0",
    "playwright": "1.56.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "rxjs": "7.8.2",
    "unified": "11.0.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/mdast": "4.0.4",
    "@types/node": "22.18.6",
    "esbuild": "0.25.10",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  },
  "optionalDependencies": {
    "@sparticuz/chromium": "153.0.0"
  },
  "files": [
    "dist",
    "src",
    ".agents",
    "README.md"
  ]
}
